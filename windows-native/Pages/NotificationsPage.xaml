<Page x:Class="TwinDesk.Native.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="22" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="Notifications" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="View and manage Android notifications directly from this Windows PC"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
            Title="Bi-directional notification sync"
            Message="Incoming Android notifications are relayed in real-time. Dismissing an alert here dismisses it on your phone."/>

        <!-- Settings Card -->
        <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Notification relay settings" FontSize="20" FontWeight="SemiBold"/>
            <ToggleSwitch x:Name="SyncToggle" Header="Receive notifications from connected Android phone" IsOn="True" Toggled="SyncToggle_Toggled"/>
            <TextBlock Text="Requires Notification Access permission granted to TwinDesk on your Android phone."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Notification List Card -->
        <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Recent alerts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="ClearAllButton" Grid.Column="1" Content="Clear all" Click="ClearAll_Click"/>
            </Grid>

            <TextBlock x:Name="EmptyNoticeText" Text="No notifications yet. When your phone receives messages or alerts, they will appear here."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

            <StackPanel x:Name="NotificationsPanel" Spacing="10"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
