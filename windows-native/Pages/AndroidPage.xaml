<Page x:Class="TwinDesk.Native.Pages.AndroidPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="Android device" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Connect your Android phone to this Windows PC" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
            Title="Pair from your phone"
            Message="The native Windows host is listening on the protocol-v1 TLS port. Start Pair on the Android app, then compare the six-digit code below before approving."/>
        <InfoBar x:Name="FirewallInfoBar" IsOpen="False" IsClosable="False" Severity="Warning"
            Title="Windows Firewall needs attention">
          <InfoBar.ActionButton>
            <Button x:Name="FixFirewallButton" Content="Fix firewall access" Click="FixFirewall_Click"/>
          </InfoBar.ActionButton>
        </InfoBar>
        <Border x:Name="PairingPromptCard" Visibility="Collapsed" Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Pairing request" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="PairingPromptTitle" Text="A device wants to pair" FontSize="15"/>
            <TextBlock Text="Compare this code with the one shown on your Android phone." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PairingCodeText" Text="------" FontSize="36" FontWeight="SemiBold" CharacterSpacing="120" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PairingStatusText" Text="Waiting for phone confirmation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="AllowPairingButton" Content="Approve pairing" IsEnabled="False" Click="ApprovePairing_Click"/>
              <Button x:Name="DenyPairingButton" Content="Deny" Click="DenyPairing_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Padding="24" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Nearby Android devices" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshDiscovery_Click"/>
            </Grid>
            <TextBlock x:Name="DiscoveryStatusText" Text="Connecting to native discovery…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="DeviceCountText" Text="No Android device snapshot yet" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="AndroidPeersPanel" Spacing="8"/>
            <TextBlock Text="USB and wireless-debugging pairing paths are still pending. Current pairing uses the existing protocol-v1 TLS and UDP discovery." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
