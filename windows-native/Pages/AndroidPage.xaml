<Page x:Class="TwinDesk.Native.Pages.AndroidPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="Android device" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Connect your Android phone to this Windows PC" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
            Title="Native core not connected yet"
            Message="Pairing will be enabled after discovery, identity, authentication and session handling have been ported. This avoids showing a button that cannot work."/>
        <Border Padding="24" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Pair an Android phone" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="The Windows client will retain Android support, including local-network discovery and supported USB / wireless-debugging paths." TextWrapping="Wrap"/>
            <Button Content="Pair Android device" IsEnabled="False" HorizontalAlignment="Left"/>
            <TextBlock Text="Pairing activates when the native transport milestone is complete." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
