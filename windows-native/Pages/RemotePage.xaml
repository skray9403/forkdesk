<Page x:Class="TwinDesk.Native.Pages.RemotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="28,20,28,36" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
        
        <!-- Header -->
        <StackPanel Spacing="3" Margin="0,0,0,4">
          <TextBlock Text="Mouse &amp; Keyboard" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Move the pointer off the edge of the screen to go to the other device, or use your phone as a touchpad."
                     FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 1. Interactive Desk Screen Layout Arrangement (Matching original "Where the other computer is") -->
        <Border CornerRadius="12" Padding="20,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="Where the other device is on your desk" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Select which side of this PC your other device sits on. The pointer crosses over that edge."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedSidePillText" Text="Right side" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
              </Border>
            </Grid>

            <!-- Visual Desk Layout Grid (3x3 Slot Picker) -->
            <Grid Width="380" Height="220" HorizontalAlignment="Center" Margin="0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="50"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>

              <!-- Top Slot -->
              <Button x:Name="SlotTopButton" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4"
                      Click="SlotButton_Click" Tag="top">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                  <TextBlock Text="Above" FontSize="11.5"/>
                </StackPanel>
              </Button>

              <!-- Left Slot -->
              <Button x:Name="SlotLeftButton" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4"
                      Click="SlotButton_Click" Tag="left">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                  <TextBlock Text="To the left" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Center: This PC Monitor -->
              <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Margin="4"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                  <FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                  <TextBlock x:Name="LayoutPcNameText" Text="This PC" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Main Display" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- Right Slot (Default Active) -->
              <Button x:Name="SlotRightButton" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4"
                      Click="SlotButton_Click" Tag="right" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                  <TextBlock Text="To the right" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Bottom Slot -->
              <Button x:Name="SlotBottomButton" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4"
                      Click="SlotButton_Click" Tag="bottom">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                  <TextBlock Text="Below" FontSize="11.5"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Layout Hint Text -->
            <TextBlock x:Name="LayoutCrossingHintText" Text="Push the mouse pointer past the right edge of your screen to cross over."
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- 2. Edge Resistance & Crossing Feel (Matching original .crossingOptions) -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Edge crossing &amp; motion feel" FontSize="14.5" FontWeight="SemiBold"/>
            
            <StackPanel Spacing="6">
              <Grid>
                <TextBlock Text="Edge resistance (push further to cross)" FontSize="13"/>
                <TextBlock x:Name="ResistanceValueText" Text="50 px" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
              <Slider x:Name="ResistanceSlider" Minimum="0" Maximum="200" StepFrequency="10" Value="50" ValueChanged="ResistanceSlider_ValueChanged"/>
            </StackPanel>

            <CheckBox x:Name="ReverseScrollCheckBox" Content="Reverse scrolling on remote device" IsChecked="False" Click="OnOptionChanged"/>
            <CheckBox x:Name="ShakeHomeCheckBox" Content="Shake this computer's mouse left and right to bring pointer back home" IsChecked="True" Click="OnOptionChanged"/>
          </StackPanel>
        </Border>

        <!-- 3. Over Bluetooth on Crowded Wi-Fi (Matching original bleInput switch) -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Mouse and keyboard over Bluetooth" FontSize="14.5" FontWeight="SemiBold"/>
              <TextBlock Text="The pointer and keys ride Bluetooth while screens, files and the clipboard stay on Wi-Fi. Recommended for crowded 2.4 GHz Wi-Fi where the pointer stutters."
                         FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="BleInputToggle" Grid.Column="1" VerticalAlignment="Center" IsOn="False" Toggled="BleInputToggle_Toggled"/>
          </Grid>
        </Border>

        <!-- 4. Phone Touchpad Remote Mode (Phone controlling this PC) -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Phone touchpad &amp; keyboard mode" FontSize="14.5" FontWeight="SemiBold"/>
            <ToggleSwitch x:Name="EnabledToggle" Header="Allow remote input from connected phone" IsOn="True" Toggled="OnOptionChanged"/>
            
            <StackPanel Spacing="6">
              <Grid>
                <TextBlock Text="Pointer speed multiplier" FontSize="13"/>
                <TextBlock x:Name="SpeedText" Text="1.0x" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
              <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.5" StepFrequency="0.1" Value="1.0" ValueChanged="SpeedSlider_ValueChanged"/>
            </StackPanel>

            <CheckBox x:Name="SmoothCheckBox" Content="Smooth cursor movement (eases rapid motions)" IsChecked="True" Click="OnOptionChanged"/>
            <CheckBox x:Name="TapClickCheckBox" Content="Tap on phone screen to left click" IsChecked="True" Click="OnOptionChanged"/>
            <CheckBox x:Name="KeyboardCheckBox" Content="Allow remote typing and keyboard shortcuts from phone" IsChecked="True" Click="OnOptionChanged"/>
          </StackPanel>
        </Border>

        <!-- 5. Input Telemetry Status Card -->
        <Border CornerRadius="10" Padding="18,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="4">
            <TextBlock Text="Input engine status" FontSize="13.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Text="Listening for Win32 SendInput events..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="LastEventText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
