<Page x:Class="TwinDesk.Native.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="22" MaxWidth="1100" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="Overview" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Your Windows workspace and Android connection" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
            Title="Native Windows foundation"
            Message="This interface is WinUI 3. It does not host a browser, WebView2 or Electron renderer. Device services are being migrated into the native client."/>
        <Grid ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Padding="22" CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Android device" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="AndroidConnectionState" Text="Waiting for discovery" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="PhoneBatteryText" Text="Battery status pending" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RingPhoneButton" Content="Ring phone" Click="RingPhone_Click"/>
                <Button x:Name="LockPhoneButton" Content="Lock phone" Click="LockPhone_Click"/>
                <Button Content="Device settings" Click="OpenAndroid_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Padding="22" CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="USB &amp; Connectivity" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="UsbSummaryText" Text="Checking USB connection…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="Zero-overhead native pipeline: UDP 47801 discovery, TLS WebSocket 47800, and Win32 SendInput remote control." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
              <Button Content="Start Screen Mirror" Style="{ThemeResource AccentButtonStyle}" Click="StartMirror_Click"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Spacing="8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Nearby peers" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshDiscovery_Click"/>
          </Grid>
          <TextBlock x:Name="DiscoveryStatusText" Text="Connecting to native discovery…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="PeerCountText" Text="No peer snapshot yet" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <StackPanel x:Name="NearbyPeersPanel" Spacing="8"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Migration status" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="The shell and LAN discovery are native. Feature actions remain unavailable until their native services and authenticated transport are connected. No page falls back to a web renderer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
