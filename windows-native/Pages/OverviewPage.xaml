<Page x:Class="TwinDesk.Native.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="22" MaxWidth="1100" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="Overview" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Your Windows workspace and Android connection" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
            Title="Native Windows foundation"
            Message="This interface is WinUI 3. It does not host a browser, WebView2 or Electron renderer. Device services are being migrated into the native client."/>
        <Grid ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Padding="22" CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Android device" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Not connected" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="Native UDP discovery is active. Pairing and authenticated sessions are the next integration milestone." TextWrapping="Wrap"/>
              <Button Content="Open Android device" HorizontalAlignment="Left" Click="OpenAndroid_Click"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Padding="22" CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Windows services" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Native shell ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="The existing C# helper is the starting point for tray, capture, input and Windows integration." TextWrapping="Wrap"/>
              <TextBlock Text="Service connection: pending" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Spacing="6">
          <TextBlock Text="Migration status" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="The shell is native. Feature actions remain unavailable until their native services are connected. No page falls back to a web renderer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
