<Page x:Class="TwinDesk.Native.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="28,20,28,36" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch">
        
        <!-- Page Header (Matching original .page-head) -->
        <StackPanel Spacing="3" Margin="0,0,0,4">
          <TextBlock Text="Connection" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Your Windows workspace and Android companion, working as one desk." 
                     FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 1. Hero Connection Card (Matching original .card.hero and .hero-devices) -->
        <Border CornerRadius="12" Padding="20,18,20,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="16">
            
            <!-- Hero Devices 3-Column Bridge -->
            <Grid ColumnSpacing="16" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Left: This PC -->
              <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                <!-- PC Monitor Silhouette Box -->
                <Border Width="72" Height="48" CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                    HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="HostDeviceNameText" Text="This PC" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                  <TextBlock x:Name="HostIpPillText" Text="127.0.0.1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
              </StackPanel>

              <!-- Center: Connection Beam & Status -->
              <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <!-- Beam line -->
                <Grid Width="160" Height="4" HorizontalAlignment="Center">
                  <Border x:Name="HeroLinkBeam" Height="3" CornerRadius="1.5" Background="{ThemeResource SystemFillColorNeutralBrush}"/>
                  <Ellipse x:Name="HeroPulseDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <!-- Status Pill Badge -->
                <Border x:Name="HeroStatusPill" CornerRadius="12" Padding="12,4" Background="{ThemeResource SystemFillColorNeutralBrush}" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="HeroStatusDot" Width="6.5" Height="6.5" Fill="#A1A1A6"/>
                    <TextBlock x:Name="HeroStatusText" Text="Ready to connect" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="HeroSubtext" Text="Checking network and cable..." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <!-- Right: Target Phone -->
              <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                <!-- Phone Silhouette Box -->
                <Border Width="40" Height="58" CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                    HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE8EA;" FontSize="22" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="PhoneNameText" Text="Android Phone" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="PhoneBatteryBadge" Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                  <TextBlock x:Name="PhoneBatteryText" Text="Waiting for phone" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Hero Actions Toolbar (Matching original .hero-actions) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
              <Button x:Name="StartMirrorButton" Content="Start Screen Mirror" Style="{ThemeResource AccentButtonStyle}" Click="StartMirror_Click">
                <Button.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control" Key="M"/>
                </Button.KeyboardAccelerators>
              </Button>
              <Button x:Name="RingPhoneButton" Content="Ring phone" Click="RingPhone_Click"/>
              <Button x:Name="LockPhoneButton" Content="Lock phone" Click="LockPhone_Click"/>
              <Button x:Name="ScanUsbButton" Content="Scan USB" Click="ScanUsb_Click"/>
              <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 2. Direct Connect & This PC Card (Matching original connect by address row) -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Connect by address" FontSize="14" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="DirectAddressInput" PlaceholderText="Phone IP (e.g. 192.168.4.185)" 
                       KeyDown="DirectAddressInput_KeyDown" VerticalAlignment="Center"/>
              <Button x:Name="ConnectAddressButton" Grid.Column="1" Content="Connect" 
                      Style="{ThemeResource AccentButtonStyle}" Click="ConnectAddress_Click"/>
            </Grid>
            <Grid ColumnSpacing="10" Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="1">
                <TextBlock Text="This PC local address:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ThisPcAddressText" Text="Detecting IP..." FontSize="13" FontWeight="SemiBold"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Copy IP" Click="CopyIp_Click" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 3. USB Cable & ADB Supervisor Card -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="8" Background="{ThemeResource SystemFillColorNeutralBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE8B0;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="USB Cable Link (ADB)" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="UsbStatusText" Text="Checking USB connection…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="Connect phone via USB with USB debugging enabled for instant ~4ms cable link." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Scan USB" Click="ScanUsb_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- 4. Found Nearby Devices Card (Matching original foundList) -->
        <Border CornerRadius="10" Padding="18,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Found nearby" FontSize="14" FontWeight="SemiBold"/>
                <Border x:Name="PeerCountPill" CornerRadius="10" Background="{ThemeResource SystemFillColorNeutralBrush}" Padding="8,2">
                  <TextBlock x:Name="PeerCountText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
              </StackPanel>
              <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshDiscovery_Click"/>
            </Grid>
            <TextBlock x:Name="DiscoveryStatusText" Text="Listening for devices on LAN (UDP 47801)..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="NearbyPeersPanel" Spacing="8"/>
          </StackPanel>
        </Border>

        <!-- 5. Windows Firewall Status Card -->
        <Border CornerRadius="10" Padding="18,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Windows Defender Firewall" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="FirewallStatusText" Text="Allow rules for TCP 47800 and UDP 47801 active." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="FixFirewallButton" Grid.Column="1" Content="Fix firewall" Click="FixFirewall_Click" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
