<Page x:Class="TwinDesk.Native.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="22" MaxWidth="900" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="About TwinDesk" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="High-performance native Windows client for Android &amp; Windows continuity"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <InfoBar IsOpen="True" IsClosable="False" Severity="Success"
            Title="Native Windows Client"
            Message="Engineered with WinUI 3 and .NET 10. Completely replaces the legacy Electron shell without any web renderer, browser engine or WebView2 control."/>

        <!-- Architecture Card -->
        <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Architectural Pillars" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="20" RowSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                <TextBlock Text="Presentation Engine" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="WinUI 3 with native Mica Backdrop" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                <TextBlock Text="Runtime Isolation" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="0 Chromium / 0 Electron / 0 WebView2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                <TextBlock Text="Target Framework" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text=".NET 10 Self-Contained" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Text="Transport Security" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="TLS WebSocket + SAS 6-digit verification" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                <TextBlock Text="Process Lifecycle" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="Single-instance Named Pipe Handoff" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                <TextBlock Text="Peer Compatibility" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="Android Companion &amp; Windows PCs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Device Identity Card -->
        <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Host Identity &amp; Cryptography" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Spacing="4">
              <TextBlock Text="Local Device Name:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="DeviceNameText" FontWeight="Medium" FontSize="14" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Device Unique ID:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="DeviceIdText" FontFamily="Consolas" FontSize="13" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="TLS Certificate Fingerprint (SHA-256):" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Diagnostics Card -->
        <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Diagnostics &amp; System Health" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="20" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                <TextBlock Text="Process Architecture:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ArchitectureText" FontWeight="Medium"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                <TextBlock Text="Working Set (RAM):" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="MemoryText" FontWeight="Medium"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                <TextBlock Text="Operating System:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="OsText" FontWeight="Medium"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Text="Firewall Status:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="FirewallText" FontWeight="Medium"/>
              </StackPanel>
            </Grid>

            <Button Content="Open Diagnostic Logs Folder" Click="OpenLogs_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
