<Window x:Class="TwinDesk.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TwinDesk">
  <Grid>
    <NavigationView x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
        PaneDisplayMode="Left" OpenPaneLength="240" CompactPaneLength="56"
        SelectionChanged="OnSelectionChanged">
      
      <!-- Original Sidebar Header Layout -->
      <NavigationView.PaneHeader>
        <StackPanel Margin="14,14,14,10" Spacing="12">
          <!-- Identity: App Mark + TwinDesk Name + Live Peer Status Dot -->
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Sleek App Mark Icon -->
            <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE703;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="TwinDesk" FontSize="17" FontWeight="Bold"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="#A1A1A6"/>
                <TextBlock x:Name="SidebarStatusText" Text="Not paired" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Connected Phone Sidebar Tile (matches original #phones tile) -->
          <Border x:Name="SidebarPhoneTile" Visibility="Collapsed" Padding="10,8" CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              PointerPressed="SidebarPhoneTile_PointerPressed">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="22" Height="38" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8EA;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="SidebarPhoneName" Text="Phone" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SidebarPhoneSub" Text="Connected" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          
          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>
        </StackPanel>
      </NavigationView.PaneHeader>

      <NavigationView.MenuItems>
        <NavigationViewItem Content="Connection" Tag="overview">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Link"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Phone" Tag="android">
          <NavigationViewItem.Icon><SymbolIcon Symbol="CellPhone"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Screen" Tag="screen">
          <NavigationViewItem.Icon><SymbolIcon Symbol="View"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Files" Tag="files">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Clipboard" Tag="clipboard">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Copy"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Remote control" Tag="remote">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Keyboard"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Audio" Tag="audio">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Volume"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Notifications" Tag="notifications">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Message"/></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="Settings" Tag="settings">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="About" Tag="about">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <NavigationView.Content>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top Sticky Pairing Banner (Matching original .banner) -->
          <Border x:Name="PairingBanner" Visibility="Collapsed" Margin="28,14,28,4" Padding="16,14" CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1.5">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Pairing Request" FontSize="14" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Verification Code:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Name="PairingSasCode" Text="000 000" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="PairingHintText" Text="Confirm that this 6-digit code matches the code on your phone." FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Codes match" Style="{ThemeResource AccentButtonStyle}" Click="ApprovePairing_Click"/>
                <Button Content="Cancel" Click="RejectPairing_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <Frame Grid.Row="1" x:Name="ContentFrame"/>
        </Grid>
      </NavigationView.Content>
    </NavigationView>
  </Grid>
</Window>
